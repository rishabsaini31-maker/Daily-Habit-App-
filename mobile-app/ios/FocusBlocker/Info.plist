<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>DHI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.dhi.focus</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>DHI</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Screen Time API Permissions -->
	<key>NSFamilyControlsUsageDescription</key>
	<string>DHI requires Screen Time permissions to shield apps and prevent dopamine distraction loops during active focus sessions.</string>

	<!-- HealthKit Step Gating Permissions -->
	<key>NSHealthShareUsageDescription</key>
	<string>DHI reads your daily step count to unlock step-gated screen time.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>DHI syncs physical activity metrics with Apple Health.</string>

	<!-- NFC Hardware Reader Permissions -->
	<key>NFCReaderUsageDescription</key>
	<string>DHI uses NFC to pair physical desk keys for instant deep work sessions and emergency hardware unlocks.</string>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
