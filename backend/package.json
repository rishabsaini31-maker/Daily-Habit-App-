{
  "name": "backend",
  "version": "1.0.0",
  "description": "Enterprise Daily Habit Tracker - Clean Architecture REST API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/infrastructure/database/migration-cli.ts up",
    "migrate:down": "tsx src/infrastructure/database/migration-cli.ts down",
    "seed": "tsx src/infrastructure/database/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "habit-tracker",
    "clean-architecture",
    "enterprise",
    "typescript"
  ],
  "author": "Engineering Team",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
